<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rails Profile" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rails Profile">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/zassets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
   
  </head>

  <body>
    <%# creates navbar at top of page site indicating the different pages you can access. Uses 'link_to' rails helper %>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">

    <!-- Brand -->
    <%# Added image/ profile photo next to name; made circular %>
    <%= link_to root_path, class: "navbar-brand d-flex align-items-center" do %>
  <%= image_tag "profilePhoto.jpg", alt: "Profile", width: 40, height: 40, class: "rounded-circle me-2" %>
  Rebecca Manna
<% end %>

    <!-- Mobile toggle -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Links at top of navbar -->
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">

        <li class="nav-item">
          <%= link_to "Home", root_path, class: "nav-link" %>
        </li>

        <li class="nav-item">
          <%= link_to "About", about_path, class: "nav-link" %>
        </li>

        <li class="nav-item">
          <%= link_to "Portfolio", portfolio_path, class: "nav-link" %>
        </li>

      </ul>
    </div>

    </div>
  </nav>
    <%= yield %>
  </body>
</html>
