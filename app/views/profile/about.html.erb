<%# This file holds the html for the 'about me' page utilizing some bootstrap, custom css, and fontawesome %>

<div class="container mt-4">

  <!-- Header Card -->
  <!-- custom mouse hover effect applied to card -->
  <div class="card text-center shadow-sm">
    <div class="card-body">
      <%#uses custom css for h1%>
      <h1 class="announcement" id="first_heading">Learn More About Me! <i class="fas fa-info-circle"></i></h1>
    </div>
  </div>

</div>

<!-- 3 Column Section -->
<div class="container my-5">
  <div class="row">

    <!-- Background -->
    <div class="col-lg-4 col-md-6 col-sm-12">
      <!-- custom mouse hover effect applied to card -->
      <div class="card h-100">
        <div class="card-body">
          <h2 class="card-title text-center mb-3">Background</h2>
          <p>
            I am a senior at Connecticut College, originally from Western Massachusetts.
            I am majoring in neuroscience, minoring in computer science, and am a part
            of the Public Health Pathway.
          </p>
          <p>
            I have always been drawn to science since I was little, and found a
            particular interest once I got to Conn in the brain and understanding
            the underlying circuitry that impacts our health and function.
            I accumulated limited experience in high school regarding computer
            science, but I saw taking up a minor as useful to providing me with
            knowledge on how to utilize programming languages in my future career.
          </p>
        </div>
      </div>
    </div>

    <!-- Skills -->
    <div class="col-lg-4 col-md-6 col-sm-12">
      <!-- custom mouse hover effect applied to card -->
      <div class="card h-100">
        <div class="card-body text-center">
          <h2 class="card-title mb-3">Skills</h2>

          <h5 class="mt-3 fw-bold">Technical Skills</h5>
          <ul class="list-unstyled">
            <li>Python</li>
            <li>Java</li>
            <li>R</li>
            <li>ChemDraw</li>
            <li>TopSpin</li>
